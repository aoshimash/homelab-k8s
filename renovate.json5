{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  // Friday-evening cadence — keeps weekday CI/build machines free of routine update noise.
  "timezone": "Asia/Tokyo",
  "schedule": ["after 6pm on friday"],

  // PR limits
  "prConcurrentLimit": 10,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "automerge": false,

  // Stabilization window — a release must be this old before Renovate proposes it,
  // so short-lived broken releases get pulled before we upgrade to them.
  // Update types that cannot supply a releaseTimestamp are handled per type in
  // packageRules below (digest / pinDigest / pin / replacement); left on Renovate
  // 42's timestamp-required default they hold renovate/stability-days pending
  // forever and poison any grouped PR they share.
  "minimumReleaseAge": "3 days",

  // Vulnerability alerts — requires GitHub's Dependabot alerts enabled on this repo.
  // These values match Renovate's own defaults for vulnerabilityAlerts (schedule/
  // minimumReleaseAge are bypassed already); set explicitly so the intent survives
  // future default changes.
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },

  // OSV-based scanning covers crate/go/npm/pypi/etc. datasources — a no-op for this
  // repo's current flux/github-actions/github-releases managers, but harmless and
  // ready if dependency types expand later.
  "osvVulnerabilityAlerts": true,

  // Exclude paths
  "ignorePaths": [
    "**/*.sops.yaml",
    ".sops.yaml",
    "k8s/flux/flux-system/gotk-components.yaml"
  ],

  // Pin every container image to an immutable digest. Floating tags (`:latest`,
  // `redis:7-alpine`, `gotenberg:8`) silently change what runs on the next pull,
  // so a digest is what makes the manifests reproducible. Renovate keeps the
  // digest in step with the tag via PRs.
  "pinDigests": true,

  // Flux HelmRelease chart versions. Patterns are slash-wrapped because
  // managerFilePatterns treats a bare string as a glob, not a regex.
  // k8s/configs is included so the gha-runner-scale-set releases are covered.
  "flux": {
    "managerFilePatterns": [
      "/k8s/infrastructure/.+\\.yaml$/",
      "/k8s/apps/.+\\.yaml$/",
      "/k8s/configs/.+\\.yaml$/"
    ]
  },

  // Container images in plain Kubernetes manifests. The kubernetes manager ships
  // with an empty managerFilePatterns by design (Renovate cannot guess which YAML
  // in a repo is a manifest), so without this block no `image:` reference in the
  // app Deployments is tracked at all. It scans any file containing both
  // `apiVersion:` and `kind:`. Images inside HelmRelease `values` are NOT its
  // job — the flux manager already extracts those (it reuses the helm-values
  // extractor on spec.values), so helmrelease.yaml is excluded via packageRules
  // below to avoid reporting the same image under two managers.
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/infrastructure/.+\\.yaml$/",
      "/k8s/apps/.+\\.yaml$/",
      "/k8s/configs/.+\\.yaml$/"
    ]
  },

  // PR labels
  "labels": ["dependencies", "renovate"],

  // Custom managers for Talos / Kubernetes versions in talconfig.yaml
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/infra/talos/talconfig\\.yaml$/"],
      "matchStrings": ["talosVersion:\\s*(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/infra/talos/talconfig\\.yaml$/"],
      "matchStrings": ["kubernetesVersion:\\s*(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    }
  ],

  "packageRules": [
    // Renovate 42 made minimumReleaseAge require a release timestamp
    // (minimumReleaseAgeBehaviour defaults to "timestamp-required"). Update types
    // that cannot supply one then sit at renovate/stability-days = pending on every
    // run, which also holds back everything grouped into the same PR.
    // https://github.com/renovatebot/renovate/releases/tag/42.0.0
    // https://docs.renovatebot.com/key-concepts/minimum-release-age/
    // https://github.com/renovatebot/renovate/issues/45236

    // digest: Renovate ages a digest bump against the newest version matching the
    // current tag. Docker Hub (tag_last_pushed) and github-tags expose that
    // timestamp, so those keep the full 3-day window; GHCR does not, and most of
    // our images live there. timestamp-optional raises the timestamp-less ones
    // instead of holding them forever, which is what the docs prescribe.
    {
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    // pinDigest: freezing a tag at what it already resolves to is not an upgrade,
    // so it should not wait out the stabilization window — a fast-releasing
    // reference would otherwise stay unpinned indefinitely. The docs give this
    // exact override as the remedy.
    {
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    // pin / replacement: the docs list both as not supported by minimumReleaseAge,
    // and the lookup stage already skips them — but the branch-stage stability
    // check does not (that is the gap in issue #45236), so pin this off explicitly
    // rather than relying on a bug being fixed. No-op if it ever is.
    {
      "matchUpdateTypes": ["pin", "replacement"],
      "minimumReleaseAge": null
    },
    // The top-level pinDigests also reaches versions the github-actions manager
    // reads from an action's `with:` input (depType `uses-with`, e.g.
    // aqua-installer's `aqua_version`). That input is a plain version string
    // with no slot for a digest, so the pin can never be written and the branch
    // fails with "Digest is not updated" on every run (renovate/pin-dependencies,
    // 2026-09-23). The `uses:` lines themselves are depType `action` and stay
    // pinned by helpers:pinGitHubActionDigests.
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "pinDigests": false
    },
    // Same gap for a Flux GitRepository pinned by `ref.tag` (local-path-provisioner,
    // whose chart has no Helm repository). The flux manager records no digest
    // location for a tag ref, yet pinDigests raises a pinDigest update for it
    // (seen in a local dry run, 2026-09-23). Adding `ref.commit` is no fix: the
    // manager then tracks commits and stops proposing tag bumps. The tag is the pin.
    {
      "matchManagers": ["flux"],
      "matchDatasources": ["github-tags"],
      "pinDigests": false
    },
    // GHCR returns no release timestamp, so *version* updates for images hosted
    // there cannot be aged either, and Renovate suppresses PR creation entirely
    // while their status is yellow — the update never surfaces at all. Seen here
    // on 2026-09-21: home-assistant v2025/v2026 and paperless-ngx v3 (all ghcr.io)
    // sat in the dashboard's "Pending Status Checks" section, while the Docker
    // Hub-hosted vikunja majors reached review as #294/#295. timestamp-optional
    // raises what cannot be aged; docker.io, github-tags and Helm charts are
    // unaffected and keep the full 3-day window.
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/**"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    // Group Helm chart updates into one PR instead of one per HelmRelease file.
    // separateMajorMinor above still splits major/minor updates into their own
    // PRs even within this group.
    {
      "matchManagers": ["flux"],
      "groupName": "Helm charts"
    },
    // Cilium is the CNI on a single-node cluster, so a regression takes the
    // whole datapath with it — and it is the one chart whose revert PR may
    // never reach the cluster: Flux needs pod egress to fetch the chart that
    // would undo the change, which is exactly the deadlock hit on 2026-05-04.
    // Recovery there is an imperative `helm rollback` plus a matching commit.
    // Keeping Cilium out of the grouped chart PR means it is always reviewed,
    // merged and verified on its own, so a post-merge failure is attributable
    // to one change. `groupName: null` is the documented way to drop a package
    // out of a group set by an earlier rule (the option defaults to null and
    // grouping only happens when it is non-null).
    {
      "matchManagers": ["flux"],
      "matchPackageNames": ["cilium"],
      "groupName": null
    },
    // Same treatment for container images: one grouped PR instead of one per
    // image, with separateMajorMinor still splitting majors into their own PR.
    // Matched by datasource rather than manager, because the runner image lives
    // inside a HelmRelease and is therefore reported by the flux manager — this
    // rule comes after the one above so it wins for that dep.
    {
      "matchDatasources": ["docker"],
      "groupName": "container images"
    },
    // The flux manager extracts images from HelmRelease `spec.values` already.
    // The kubernetes manager reads the same files (they carry apiVersion/kind),
    // so leaving it enabled reports the arc-runners runner image twice and would
    // produce two PRs editing the same line. Plain manifests remain covered.
    {
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["**/helmrelease.yaml"],
      "enabled": false
    },
    // Manual-apply instructions injected into PR bodies. Talos OS and Kubernetes
    // upgrades are kept as separate rules (and therefore separate PRs) because
    // their apply procedures, blast radius, and verification differ.
    {
      "matchPackageNames": ["siderolabs/talos"],
      "prBodyNotes": [
        "**Confirm talhelper supports Talos {{newValue}} before merging** — check out this branch and run `task talos:genconfig`; a generation failure means **do not merge** (see [PR review criteria](https://github.com/aoshimash/homelab-k8s/blob/main/docs/talos-operations.md#pr-review-criteria)).",
        "talhelper is pinned in `aqua.yaml` outside Renovate and is released on its own schedule, so a new Talos minor can arrive before talhelper understands its config schema — #293 merged that way and had to be reverted in #314.",
        "**Manual action required after merge** — this PR does not auto-apply.",
        "After merging, follow the Talos OS upgrade procedure in [docs/talos-operations.md — Renovate upgrade flow](https://github.com/aoshimash/homelab-k8s/blob/main/docs/talos-operations.md#renovate-upgrade-flow). The procedure includes the `talosctl upgrade` invocation, health-check gate, and rollback strategy."
      ]
    },
    {
      "matchPackageNames": ["kubernetes/kubernetes"],
      "prBodyNotes": [
        "**Manual action required after merge** — this PR does not auto-apply.",
        "After merging, follow the Kubernetes upgrade procedure in [docs/talos-operations.md — Renovate upgrade flow](https://github.com/aoshimash/homelab-k8s/blob/main/docs/talos-operations.md#renovate-upgrade-flow). The procedure includes the `talosctl upgrade-k8s` invocation and verification."
      ]
    },
    // Stateful apps: these images migrate their own database on first start, and
    // the migrations are one way. Flux reconciles a revert PR back to the old tag
    // within minutes, but the old binary cannot read the migrated schema, so the
    // revert restores the image and not the service — the rollback path is a
    // restore from backup, and only backups taken *before* the merge are useful.
    // prBodyNotes is a mergeable option, so a grouped "container images" PR
    // carries the note for every stateful app it happens to contain; each note
    // therefore names its own package.
    {
      "matchPackageNames": ["vikunja/vikunja"],
      "prBodyNotes": [
        "**Back up before merging** — `vikunja` migrates its database one way on first start.",
        "Take an on-demand backup with [docs/cloudnative-pg.md — Create Manual Backup](https://github.com/aoshimash/homelab-k8s/blob/main/docs/cloudnative-pg.md#create-manual-backup) before merging; the scheduled one runs daily at 18:00 UTC and is kept 7 days, which is also how long the rollback window lasts. Recovery is [Restore from Backup](https://github.com/aoshimash/homelab-k8s/blob/main/docs/cloudnative-pg.md#restore-from-backup). Attachments live on the `vikunja-files` volume and are not schema-migrated."
      ]
    },
    {
      "matchPackageNames": ["ghcr.io/paperless-ngx/paperless-ngx"],
      "prBodyNotes": [
        "**Back up before merging** — `paperless-ngx` runs Django migrations against the `paperless` database one way on first start, and may rewrite document metadata (3.0.0 recomputed every checksum as SHA-256).",
        "Back up both halves before merging, and pair them correctly: the database via [docs/cloudnative-pg.md — Create Manual Backup](https://github.com/aoshimash/homelab-k8s/blob/main/docs/cloudnative-pg.md#create-manual-backup) (kept 7 days), and the `paperless-data` / `paperless-media` volumes via [docs/longhorn.md — Create an On-Demand Backup](https://github.com/aoshimash/homelab-k8s/blob/main/docs/longhorn.md#create-an-on-demand-backup). A restore must not pair a database backup newer than the volume backup — see [Backup Configuration Notes](https://github.com/aoshimash/homelab-k8s/blob/main/docs/cloudnative-pg.md#backup-configuration-notes)."
      ]
    },
    {
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "prBodyNotes": [
        "**Back up before merging** — Home Assistant migrates the recorder schema in the `homeassistant` database one way. Because the tag is CalVer, Renovate reports a new year as a major and a new month as a minor: both run recorder migrations, so this note applies to either.",
        "Back up the database via [docs/cloudnative-pg.md — Create Manual Backup](https://github.com/aoshimash/homelab-k8s/blob/main/docs/cloudnative-pg.md#create-manual-backup) (kept 7 days) and the `home-assistant-config` volume — which holds `.storage`, i.e. every UI-configured integration — via [docs/longhorn.md — Create an On-Demand Backup](https://github.com/aoshimash/homelab-k8s/blob/main/docs/longhorn.md#create-an-on-demand-backup).",
        "A schema step below `LIVE_MIGRATION_MIN_SCHEMA_VERSION` blocks startup until it finishes rather than migrating in the background, so expect the pod to stay unready for the duration. Read the backward-incompatible changes for every release between the running version and the target."
      ]
    }
  ]
}
